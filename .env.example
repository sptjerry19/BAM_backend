APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:nugRhXRzO7LCBYtnyXJletNrpIEnCCvZoRFvg67UhpY=
APP_DEBUG=true
# Production EC2: https://jbam.id.vn
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jbam
DB_USERNAME=jbam
DB_PASSWORD=secret
# Used by docker-compose MySQL service
DB_ROOT_PASSWORD=rootsecret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-2
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

JWT_SECRET=

# Scout — compose overrides host/driver inside containers
SCOUT_DRIVER=collection
SCOUT_PREFIX=jb_
SCOUT_QUEUE=false
ELASTICSEARCH_HOST=
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_SSL_VERIFICATION=false

# Docker compose extras
# Reindexing a large catalog blocks php-fpm startup and OOMs 1GB EC2 during deploy.
# Keep false on production; run scout:import by hand when the box is idle.
RUN_SCOUT_IMPORT=false
# CI/deploy sets this to true so php-fpm starts before migrate runs.
SKIP_ENTRYPOINT_MIGRATE=false
APP_PORT=8080
# t3.micro (1GB): giữ heap nhỏ, nếu không OOM killer sẽ giết php/migrate (exit 137)
ES_JAVA_OPTS="-Xms256m -Xmx256m"
ES_MEM_LIMIT=768m
MYSQL_MEM_LIMIT=512m
